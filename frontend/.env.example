# Base URL of the API as seen by the browser. Keep "/api/v1" when the API is proxied
# (Vite dev server, or a Vercel/Netlify rewrite) - recommended so auth cookies are first-party.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api requests to (development only).
VITE_PROXY_TARGET=http://localhost:8000
