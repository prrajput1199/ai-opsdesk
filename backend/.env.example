# ---- Django ----
DJANGO_DEBUG=True
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://<password>:<password>@localhost:5432/opsdesk

# ---- Frontend origins (only needed if the frontend is on a different origin than the API) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Auth cookies ----
# Defaults to True when DJANGO_DEBUG=False. Keep True in production (HTTPS only).
# AUTH_COOKIE_SECURE=False
# Lax works when the frontend and API share a site (recommended). Use None only for cross-site setups (requires Secure).
AUTH_COOKIE_SAMESITE=Lax
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---- Gemini ----
# Get a key at https://aistudio.google.com/apikey . Leave empty to run without AI (the UI shows a fallback).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=12000
# thread (default) | sync | off
AI_CLASSIFICATION_MODE=thread

# ---- Rate limits ----
THROTTLE_AUTH=10/min
THROTTLE_REGISTER=5/min
THROTTLE_AI=20/min

# ---- Demo data (development only) ----
DEMO_PASSWORD=OpsDesk@2026
